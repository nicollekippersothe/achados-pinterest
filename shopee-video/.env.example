SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# api | playwright
PUBLISHER=playwright

# Intervalo mínimo entre publicações (minutos). Mantenha alto para não parecer robô.
MIN_INTERVAL_MIN=90
MAX_TENTATIVAS=3

# Playwright
STORAGE_STATE=./storageState.json
SHOPEE_UPLOAD_URL=
HEADLESS=true

# Shopee Open API (só se a sua conta tiver acesso aos endpoints de vídeo)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_USER_ID=

# Descoberta automática (API de Afiliados: affiliate.shopee.com.br > API aberta)
AFFILIATE_APP_ID=
AFFILIATE_SECRET=
# Palavras separadas por vírgula; vazio = geral
KEYWORDS=casa,cozinha,organizador,beleza
FILA_MIN=3
DISCOVER_PER_RUN=2
MIN_COMISSAO=0.08
MIN_VENDAS=100
MIN_NOTA=4.5

# Fonte de vídeos: telegram (padrão, funciona de qualquer IP) e/ou api (abre página do produto, Shopee bloqueia datacenter)
FONTES=telegram
TELEGRAM_CANAIS=achadosshopebrasil,achadinhosshopeeb,videosachadinhosshopeebr,videosdeprodutosshopee
TELEGRAM_PAGINAS=2
