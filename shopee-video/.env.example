SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# api | playwright
PUBLISHER=playwright

# Intervalo mínimo entre publicações (minutos). Mantenha alto para não parecer robô.
MIN_INTERVAL_MIN=90
MAX_TENTATIVAS=3

# Playwright
STORAGE_STATE=./storageState.json
SHOPEE_UPLOAD_URL=
HEADLESS=true

# Shopee Open API (só se a sua conta tiver acesso aos endpoints de vídeo)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_ACCESS_TOKEN=
SHOPEE_USER_ID=
